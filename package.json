{
  "name": "php-chrome-extension",
  "version": "2.0.0",
  "description": "PHP - Paste History Past: Privacy-first, 100% local, high-performance clipboard history Chrome extension.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build && node scripts/copy-assets.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && node scripts/package-extension.mjs"
  },
  "keywords": [
    "chrome-extension",
    "clipboard-manager",
    "manifest-v3",
    "typescript",
    "vite",
    "privacy-first",
    "vitest"
  ],
  "author": "Fnnk",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "archiver": "^7.0.1",
    "eslint": "^9.0.0",
    "happy-dom": "^14.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
