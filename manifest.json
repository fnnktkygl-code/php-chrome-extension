{
  "manifest_version": 3,
  "name": "PHP - Paste History Past",
  "version": "2.0.0",
  "description": "Quick access to your clipboard history with multi-language support - never lose copied text again",
  "homepage_url": "https://github.com/fnnktkygl-code/php-chrome-extension",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "alarms",
    "notifications",
    "favicon",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PHP - Paste History Past",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Command+Shift+V"
      },
      "description": "Open clipboard history"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}